<Window x:Class="Demo.Layouts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo.Layouts"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
            <Setter Property="Padding" Value="3"></Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderThickness" Value="0"></Setter>
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="FontSize" Value="10"></Setter>
            <Setter Property="Margin" Value="10,2,2,2"></Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Left" Background="#343A40">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="* "></RowDefinition>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Image Source="/logo.png" Margin="5"></Image>
                <TextBlock Padding="15" Foreground="White" Grid.Column="1" Text="UAC Integrated Systems" VerticalAlignment="Center" FontWeight="Bold"></TextBlock>
            </Grid>
            <Grid Grid.Row="1">
                <StackPanel>
                    <Label Content="Registrar Module" Foreground="White"></Label>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="/paper.png" Margin="5" ></Image>
                        <Label Content="Admissions" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="/33308.png" Margin="5"></Image>
                        <Label Content="Student" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image  Margin="5" Source="/layer.png"></Image>
                        <Label Content="Sections" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="/grade.png" Margin="5"></Image>
                        <Label Content="Grades Encoding" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="/list.png" Margin="5"></Image>
                        <Label Content="Subject" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="/google-docs.png" Margin="5"></Image>
                        <Label Content="Reports" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="/settings-gears.png" Margin="5"></Image>
                        <Label Content="Maintenance" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="/megaphone.png" Margin="5"></Image>
                        <Label Content="Announcements" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="/chart-file.png" Margin="5"></Image>
                        <Label Content="Survey" Grid.Column="1" VerticalAlignment="Center" Foreground="#A0A5AD"></Label>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid DockPanel.Dock="Top" Height="40" Background="#FFFFC107">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock></TextBlock>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1" Text="Laurencce Mirandilla"></TextBlock>
            <Image Margin="8" Source="/Untitled.png"></Image>
            <Image Margin="8" Grid.Column="2" Source="/gear.png"></Image>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Image Source="/pngtree-statistics-linear-icon-web-analysis-business-vector-png-image_41908806.jpg" ></Image>
                <Label Content="Statistics(2026-2027)" Grid.Column="1" ></Label>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Image Source="/images.png"></Image>
                <Label Content="Last 3 Days Application" Grid.Column="1" ></Label>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Image Source="/33308.png"></Image>
                <Label Content="For Your Interview" Grid.Column="1" ></Label>
            </Grid>
            <Grid Margin="5,5,5,0" Grid.Row="1" Height="63" VerticalAlignment="Top">

                <Border Name="mask" Background="#FFFFFF" CornerRadius="5,5,5,5" Opacity="1"  />
                <StackPanel   Background="#FFFFFf" Margin="1"  >
                    <StackPanel.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=mask}"/>
                    </StackPanel.OpacityMask>
                    <StackPanel.Effect>
                        <DropShadowEffect Color="#FFC7C7C7"  BlurRadius="2" ShadowDepth="1"/>
                    </StackPanel.Effect>
                    <Label Content="117" FontWeight="Bold" FontSize="14" VerticalAlignment="Top"/>
                    <Label Content="Total Applicants"></Label>

                </StackPanel>
            </Grid>
            <Grid Margin="5,5,5,0" Grid.Row="2" Height="63" VerticalAlignment="Top">
