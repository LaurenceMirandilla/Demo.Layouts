                    <Label Content="Senior High School"></Label>

                </StackPanel>
            </Grid>
            <Grid Margin="5,5,5,0" Grid.Row="4" Grid.Column="1" Height="63" VerticalAlignment="Top">
                <StackPanel   Background="#FFFFFf" Margin="1"  >
                    <StackPanel.OpacityMask>
