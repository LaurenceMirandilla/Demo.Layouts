                    <Label Content="117" FontWeight="Bold" FontSize="14" VerticalAlignment="Top"/>
                    <Label Content="Statistics(2026-2027)"></Label>

                </StackPanel>
            </Grid>
            <Grid Margin="5,5,5,0" Grid.Row="1" Grid.Column="1" Height="63" VerticalAlignment="Top">
                <StackPanel   Background="#FFFFFf" Margin="1"  >
                    <StackPanel.OpacityMask>
