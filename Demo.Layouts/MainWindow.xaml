                </StackPanel>
            </Grid>
            <Grid.Background>
                <ImageBrush ImageSource="/logo.png" Stretch="Uniform" Opacity="0.25"></ImageBrush>

            </Grid.Background>
        </Grid>


    </DockPanel>
