                </StackPanel>
            </Grid>
            <Grid Margin="5,5,5,0" Grid.Row="1" Grid.Column="2" Height="63" VerticalAlignment="Top">
                <StackPanel   Background="#DC3545" Margin="1"  >
                    <StackPanel.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=mask}"/>
                    </StackPanel.OpacityMask>
                    <StackPanel.Effect>
                        <DropShadowEffect Color="#FFC7C7C7"  BlurRadius="2" ShadowDepth="1"/>
                    </StackPanel.Effect>
                    <Label Content="0" FontWeight="Bold" FontSize="14" VerticalAlignment="Top" Foreground="White" />
